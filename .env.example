# Uso local. Não envie o arquivo .env ao GitHub.
COMPILER_ENV=development
COMPILER_PORT=5000
# Vazio: usa reunioes.db na raiz. No Render, o Blueprint define outro caminho.
COMPILER_DB_PATH=

# Opcional: configure AMBOS para usar o resumo externo.
# Sem chave, o dashboard e o assistente usam o processamento local.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_TRANSCRIPT_CHARS=50000
